{
  "database": "Zotero",
  "noteImportFolder": "01-Fonti",
  "pdfExportImageDPI": 120,
  "pdfExportImageFormat": "jpg",
  "pdfExportImageQuality": 90,
  "citeFormats": [
    {
      "name": "Citazione",
      "format": "formatted-citation"
    },
    {
      "name": "Bibliografia",
      "format": "formatted-bibliography",
      "cslStyle": "nature"
    },
    {
      "name": "Citazione (Pandoc)",
      "format": "pandoc"
    }
  ],
  "exportFormats": [
    {
      "name": "Import #1",
      "outputPathTemplate": "01-Fonti/{{citekey}}.md",
      "imageOutputPathTemplate": "{{citekey}}/",
      "imageBaseNameTemplate": "image",
      "templatePath": "90-Templates/Zotero/Annotazione Allegati (Template Zotero).md",
      "cslStyle": "universita-di-bologna-lettere"
    }
  ],
  "citeSuggestTemplate": "[[{{citekey}}]]",
  "openNoteAfterImport": true,
  "whichNotesToOpenAfterImport": "first-imported-note"
}